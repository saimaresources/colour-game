<!DOCTYPE html>
<html lang="ur">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rangon ki Duniya</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            text-align: center;
            direction: rtl;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            background: white;
            margin: 20px auto;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        h1 { color: #4a4a4a; font-size: 2.5rem; margin-bottom: 10px; }
        .score-board { font-size: 1.5rem; color: #2ecc71; font-weight: bold; margin-bottom: 20px; }
        .question-box {
            background: #f0f3f4;
            padding: 20px;
            border-radius: 15px;
            font-size: 2rem;
            font-weight: bold;
            color: #34495e;
            margin-bottom: 30px;
            border: 3px dashed #3498db;
        }
        .color-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .color-btn {
            height: 120px;
            border-radius: 15px;
            border: 5px solid white;
            box-shadow: 0 5px 10px rgba(0,0,0,0.15);
            cursor: pointer;
            transition: transform 0.2s;
        }
        .color-btn:hover { transform: scale(1.05); }
        .feedback { font-size: 1.8rem; font-weight: bold; margin-top: 20px; height: 40px; }
    </style>
</head>
<body>

<div class="container">
    <h1>🎨 rangon ki duniya</h1>
    <div class="score-board">Points: <span id="score">0</span></div>
    
    <div class="question-box">
        Urdu naam: <span id="target-name" style="color: #e74c3c;">Lal</span>
    </div>

    <div class="color-options">
        <div class="color-btn" id="btn0" onclick="checkAnswer(0)"></div>
        <div class="color-btn" id="btn1" onclick="checkAnswer(1)"></div>
        <div class="color-btn" id="btn2" onclick="checkAnswer(2)"></div>
        <div class="color-btn" id="btn3" onclick="checkAnswer(3)"></div>
    </div>

    <div class="feedback" id="feedback"></div>
</div>

<script>
    const colorsData = [
        { name: "Lal (Surkh)", hex: "#ff0000" },
        { name: "Neela", hex: "#0000ff" },
        { name: "Hara", hex: "#008000" },
        { name: "Peela", hex: "#ffff00" },
        { name: "Kala", hex: "#000000" },
        { name: "Safaid", hex: "#ffffff" },
        { name: "Gulabi", hex: "#ffc0cb" },
        { name: "Narangi", hex: "#ffa500" }
    ];

    let currentQuestion = {};
    let options = [];
    let score = 0;

    function startGame() {
        // Pick a random target color
        currentQuestion = colorsData[Math.floor(Math.random() * colorsData.length)];
        document.getElementById("target-name").innerText = currentQuestion.name;
        
        // Generate options including the correct one
        options = [currentQuestion];
        while(options.length < 4) {
            let randomColor = colorsData[Math.floor(Math.random() * colorsData.length)];
            if(!options.includes(randomColor)) {
                options.push(randomColor);
            }
        }
        
        // Shuffle options
        options.sort(() => Math.random() - 0.5);

        // Apply colors to buttons
        for(let i=0; i<4; i++) {
            let btn = document.getElementById("btn" + i);
            btn.style.backgroundColor = options[i].hex;
            // Border fix for white color
            if(options[i].hex === "#ffffff") {
                btn.style.borderColor = "#ccc";
            } else {
                btn.style.borderColor = "white";
            }
        }
        document.getElementById("feedback").innerText = "";
    }

    function checkAnswer(index) {
        let feedback = document.getElementById("feedback");
        if(options[index].name === currentQuestion.name) {
            score += 10;
            document.getElementById("score").innerText = score;
            feedback.innerText = "🎉 Shabaash! Sahi Jawab!";
            feedback.style.color = "#2ecc71";
            
            // Text-to-speech for kids interaction
            let speech = new SpeechSynthesisUtterance("Shabaash");
            window.speechSynthesis.speak(speech);

            setTimeout(startGame, 1500);
        } else {
            feedback.innerText = "❌ Ohho! Dobara Koshish Karein.";
            feedback.style.color = "#e74c3c";
        }
    }

    // Start on load
    startGame();
</script>

</body>
</html>

